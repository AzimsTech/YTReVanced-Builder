# YTReVanced variant configuration.
# Sourced by build.yml and the *.sh scripts (VARIANT=revanced).
# Keep the key list identical in variants/morphe.env.

NAME=YTReVanced
BRAND=ReVanced
TAG_SUFFIX=revanced

# CLI
CLI_REPO=revanced/revanced-cli
CLI_JAR='revanced-cli-*-all.jar'
CLI_JAR_REGEX='^revanced-cli-.*-all\.jar$'
CLI_VERSION_SED='s/^revanced-cli-(.+)-all\.jar$/\1/'

# Patches
PATCHES_SCRIPT=get-dev-rvp.sh
PATCHES_GLOB='patches-*.rvp'
PATCH_FLAG=-bp
PATCHES_REPO=ReVanced/revanced-patches

# flags for `list-patches` (fetch-yt-ver.sh); LIST_EXTRA goes after --filter-package-name
LIST_FLAGS='--packages --versions -bp patches-*.rvp'
LIST_EXTRA=''

# Signing
KEYSTORE_NAME=yt-patched.keystore
KEYSTORE_GLOB='YTReVanced_*-patched.keystore'
